{
  "name": "figma-spec-compressor",
  "version": "1.1.0",
  "description": "Token-optimized AST pruning, MCP server, and spec extractor for Figma-to-Agent workflows (Cursor / Claude Code)",
  "main": "dist/index.js",
  "bin": {
    "figma-spec": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:commercial": "node --import tsx scripts/build-commercial.ts",
    "package:commercial": "node --import tsx scripts/package-release.ts",
    "license:issue": "node --import tsx scripts/issue-license.ts",
    "test": "node --import tsx --test tests/compressor.test.ts tests/mcp-and-scale.test.ts tests/commercial.test.ts",
    "benchmark": "node --import tsx tests/benchmark.ts",
    "start": "node --import tsx src/cli.ts",
    "mcp": "node --import tsx src/cli.ts mcp",
    "serve": "node --import tsx src/server.ts"
  },
  "keywords": [
    "figma",
    "mcp",
    "cursor",
    "claude-code",
    "ast-pruning",
    "tokens"
  ],
  "author": "Solo Overseas",
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "commander": "^12.1.0",
    "gpt-tokenizer": "^2.8.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.2",
    "javascript-obfuscator": "^5.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
