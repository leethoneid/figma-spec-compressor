{
  "name": "figma-spec-compressor",
  "version": "1.0.0",
  "description": "Token-optimized AST pruning and spec extractor for Figma-to-Agent workflows (Cursor / Claude Code)",
  "main": "dist/index.js",
  "bin": {
    "figma-spec": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "benchmark": "node --import tsx tests/benchmark.ts",
    "start": "node --import tsx src/cli.ts",
    "serve": "node --import tsx src/server.ts"
  },
  "keywords": [
    "figma",
    "mcp",
    "cursor",
    "claude-code",
    "ast-pruning",
    "tokens"
  ],
  "author": "Solo Overseas",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "gpt-tokenizer": "^2.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
